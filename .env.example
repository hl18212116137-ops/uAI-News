# ─── 数据库（PostgreSQL） ────────────────────────────────────────────────────
DATABASE_URL=postgresql://ainews:ainews_secret@localhost:5432/ainews

# ─── NextAuth 认证 ───────────────────────────────────────────────────────────
NEXTAUTH_SECRET=dev_secret_change_in_production
NEXTAUTH_URL=http://localhost:3000

# ─── 站点配置 ────────────────────────────────────────────────────────────────
# 站点绝对 URL（用于 metadata / Open Graph）
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 首页服务端分段耗时日志
# PERF_HOME_SERVER_LOG=1

# 浏览器控制台输出 Web Vitals
# NEXT_PUBLIC_WEB_VITALS_LOG=1

# ─── 流水线 ──────────────────────────────────────────────────────────────────
PROCESSING_JOBS_ENABLED=false

# 内部 Cron 密钥
CRON_SECRET=

# 为 true 时在无真实推文时注入英文 demo 占位（默认关闭）
# FEED_DEMO_FALLBACK=false

# 首页/订阅流最低重要性分（0–100），低于此分不展示
FEED_MIN_IMPORTANCE_SCORE=55

# 删除 published_at 早于 N 天的 news_items
NEWS_RETENTION_DAYS=30

# 单 handle 每轮抓取最多保留条数
FETCH_MAX_POSTS_PER_HANDLE_PER_RUN=

# raw 预筛
RAW_MIN_OUTER_CHARS=12
RAW_MIN_NESTED_CHARS_RETWEET=35

# RSS/Blog 去重
# INGEST_DEDUPE_RSS_BLOG_MATCH_NEWS_URL=false

# 管理员
# PIPELINE_ADMIN_EMAILS=
# PIPELINE_ADMIN_USER_IDS=

# ─── 外部 API ────────────────────────────────────────────────────────────────
TWITTERAPI_IO_KEY=your_twitterapi_io_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MINIMAX_API_KEY=

# Optional: discover original longform articles from tweet screenshots.
# Requires an OpenAI-compatible vision chat-completions endpoint.
# LONGFORM_IMAGE_DISCOVERY_ENABLED=true
# LONGFORM_VISION_API_URL=https://api.openai.com/v1/chat/completions
# LONGFORM_VISION_API_KEY=
# LONGFORM_VISION_MODEL=
# LONGFORM_IMAGE_MATCH_MIN_SCORE=0.72
# LONGFORM_TEXT_DISCOVERY_ENABLED=true
# LONGFORM_TEXT_MATCH_MIN_SCORE=0.62
# LONGFORM_ARXIV_SEARCH_ENABLED=true

# ─── 去重配置 ────────────────────────────────────────────────────────────────
HARD_DEDUP_ENABLED=true

SMART_DEDUP_TIME_WINDOW_DAYS=7
SMART_DEDUP_SIMILARITY_THRESHOLD=0.9

SEMANTIC_DEDUP_ENABLED=true
SEMANTIC_DEDUP_TIME_WINDOW_HOURS=48
SEMANTIC_DEDUP_BATCH_SIZE=20
SEMANTIC_DEDUP_SIMILARITY_THRESHOLD=75
SEMANTIC_DEDUP_OVERLAP_SIZE=10

# ─── 评分权重 ────────────────────────────────────────────────────────────────
SCORE_WEIGHT_AUTHORITY=0.35
SCORE_WEIGHT_IMPORTANCE=0.30
SCORE_WEIGHT_DENSITY=0.25
SCORE_WEIGHT_RECENCY=0.10

# ─── 抓取性能 ────────────────────────────────────────────────────────────────
FETCH_CONCURRENT_LIMIT=5
FETCH_BATCH_DELAY_MS=2000
FETCH_USER_INFO_CONCURRENT=5
FETCH_USER_INFO_DELAY_MS=1000

# ─── AI 处理 ─────────────────────────────────────────────────────────────────
AI_BATCH_DELAY_MS=500
