# ─── 数据库 ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ainews:your_strong_password@postgres:5432/ainews
DB_PASSWORD=your_strong_password

# ─── NextAuth 认证 ───────────────────────────────────────────────────────────
# 生成方式: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_at_least_32_chars
NEXTAUTH_URL=https://yourdomain.com

# ─── 站点配置 ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
FEED_VISIBLE_DAYS=7
NEWS_RETENTION_DAYS=30
PROCESSING_JOBS_ENABLED=false

# ─── AI / 外部服务 ───────────────────────────────────────────────────────────
# AI 服务提供商：deepseek / minimax / claude
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# AI Key 加密使用此密钥；未配置则使用 NEXTAUTH_SECRET（至少 32 字符）。
# 保存过面板配置后应保持此密钥稳定，轮换时需重新保存 API Key。
# AI_SETTINGS_ENCRYPTION_KEY=
TWITTERAPI_IO_KEY=

# Optional: discover original longform articles from tweet screenshots.
# Requires an OpenAI-compatible vision chat-completions endpoint.
# LONGFORM_IMAGE_DISCOVERY_ENABLED=true
# LONGFORM_VISION_API_URL=https://api.openai.com/v1/chat/completions
# LONGFORM_VISION_API_KEY=
# LONGFORM_VISION_MODEL=
# LONGFORM_IMAGE_MATCH_MIN_SCORE=0.72
# LONGFORM_TEXT_DISCOVERY_ENABLED=true
# LONGFORM_TEXT_MATCH_MIN_SCORE=0.62
# LONGFORM_ARXIV_SEARCH_ENABLED=true

# ─── 流水线（可选） ──────────────────────────────────────────────────────────
CRON_SECRET=
# PIPELINE_ADMIN_EMAILS=
